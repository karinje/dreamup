{
  "name": "dreamup-qa-agent",
  "version": "1.0.0",
  "description": "AI-powered QA agent for autonomous browser game testing",
  "type": "module",
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "bin": {
    "qa-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "echo \"Tests not yet implemented\" && exit 0"
  },
  "keywords": [
    "qa",
    "testing",
    "browser-automation",
    "game-testing",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@browserbasehq/stagehand": "^1.6.3",
    "ai": "^4.0.0",
    "dotenv": "^16.4.5",
    "gif-encoder-2": "^1.0.5",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
